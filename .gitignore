# === CRITICAL: SECRETS & KEYS ===
.env
.env.*
!.env.example
credentials.json
client_secret*.json
*.pem
*.key

# === PACKAGE MANAGER (uv & python) ===
.venv/
__pycache__/
*.py[cod]
*$py.class
.python-version
# Keep uv.lock and pyproject.toml as they are vital for others to run your code

# === AGENTIC / RAG ARTIFACTS ===
# Ignore local vector store persistence if you ever run Weaviate locally
weaviate_data/
# Ignore locally downloaded Arxiv PDFs or research papers
data/
downloads/
*.pdf
# Ignore LLM traces or agent logs
chain_cache/
*.log
**/logs/

# === IDE & TOOLS ===
.vscode/
.idea/
.cursor/
*.swp
.DS_Store
# If you use the 'uv' tool for indexing, ignore its cache
.uv/

# === DATA & MODELS ===
# Large files that should stay local
*.bin
*.safetensors
*.onnx
hf_cache/
*.pkl
*.db
*.sqlite3